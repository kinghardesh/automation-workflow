Domain
Basic feasibility
Team eligibility</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Screening" sourceRef="T_Screen" targetRef="Annotation_Screening" />
  </bpmn:collaboration>
