<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LoanOrigination" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.20.0">
  <bpmn:message id="Message_Withdraw" name="Withdraw at any stage" />
  <bpmn:message id="Message_CreditReport" name="Credit report received" />
  <bpmn:message id="Message_DisbursementConfirmed" name="Disbursement confirmed" />
  <bpmn:error id="Error_System" name="System error" errorCode="SYSTEM_ERROR" />
  <bpmn:error id="Error_ApiTimeout" name="System error / API timeout" errorCode="API_TIMEOUT" />
  <bpmn:error id="Error_Disbursement" name="Disbursement error" errorCode="DISBURSEMENT_ERROR" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Main" name="Assignment 3: Loan Origination &amp; Approval System" processRef="Process_LoanOrigination" />
  </bpmn:collaboration>
  <bpmn:process id="Process_LoanOrigination" name="Assignment 3: Loan Origination &amp; Approval System" isExecutable="true" camunda:historyTimeToLive="P30D">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Applicant" name="Applicant">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_MissingDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Provide7d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Resubmitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Lapsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ReceiveOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_AcceptOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OfferExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ESign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_ESign7d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_ESignMsg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_Withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Withdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LoanOfficer" name="Loan Officer">
        <bpmn:flowNodeRef>T_Initial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_DocsValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CheckIncome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_GenOffer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Underwriter" name="Underwriter / Credit Committee">
        <bpmn:flowNodeRef>F_Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_AutoApprove</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ManualReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Counter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SendRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AppRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_InitA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_DisbError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_DisbSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CreateLoanAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LoanDisbursed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Fraud" name="Fraud &amp; Compliance Team">
        <bpmn:flowNodeRef>T_RunFraud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_FraudFlag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_FraudConfirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RejectFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Terminate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Fraud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Handle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Retry</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CreditBureau" name="Credit Bureau (External)">
        <bpmn:flowNodeRef>T_RequestCredit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Api</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RetryC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_StillC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ManualCredit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ReceiveCredit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Hold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AppFailed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Operations" name="Operations / Disbursement">
        <bpmn:flowNodeRef>T_VerifyCollateral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Collateral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Revaluation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_StillNotOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RejectApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RejectedCollateral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_VerifyBank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ValidAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RequestCorrect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_InitB</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CoreBanking" name="Core Banking System">
        <bpmn:flowNodeRef>T_CreateTemp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_SysErr1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Retry1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Still1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ManualRecord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_UpdateStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CreateLoanDisburse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_SysErr2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Retry2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Still2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_Disb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_UpdateLoanStatus</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_Submit" name="Submit Loan Application (with documents)" camunda:candidateGroups="applicants">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="Ev_MissingDocs" name="Missing/Invalid documents">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition camunda:type="external" camunda:topic="missing-invalid-documents" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="T_Provide" name="Provide Missing / Correct Documents (max 3 attempts)" camunda:candidateGroups="applicants">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_Provide7d" name="7 days" attachedToRef="T_Provide">
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration>P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="GW_Resubmitted" name="Resubmitted in time?" default="Flow_9">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Lapsed" name="Application Lapsed">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_ReceiveOffer" name="Receive Loan Offer" camunda:candidateGroups="applicants">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_AcceptOffer" name="Accept Offer within validity (15 days)?" default="Flow_33">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_OfferExpired" name="Offer Expired">
      <bpmn:incoming>Flow_33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_ESign" name="E-sign Loan Agreement" camunda:candidateGroups="applicants">
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_ESign7d" name="7 days" attachedToRef="T_ESign">
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration>P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_ESignMsg" name="Withdrawal request" attachedToRef="T_ESign">
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Withdraw" />
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="Ev_Withdraw" name="Withdraw at any stage">
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
      <bpmn:messageEventDefinition camunda:type="external" camunda:topic="withdraw-application" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_Withdrawn" name="Application Withdrawn">
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:incoming>Flow_36</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_Initial" name="Initial Review &amp; Check Document Completeness" camunda:candidateGroups="loan-officers">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_DocsValid" name="Documents valid?" default="Flow_5">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Verify" name="Verify Identity (KYC)" camunda:candidateGroups="loan-officers">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_CheckIncome" name="Check Income / Employment" camunda:candidateGroups="loan-officers">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="J_Join">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_Prepare" name="Prepare Credit Assessment Report" camunda:candidateGroups="loan-officers">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_GenOffer" name="Generate Loan Offer (Amount, Tenure, Interest Rate)" camunda:candidateGroups="loan-officers">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="F_Fork">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="GW_AutoApprove" name="Auto Approve?" default="Flow_23">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_ManualReview" name="Manual Review by Underwriter" camunda:candidateGroups="underwriters">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Approve" name="Approve?" default="Flow_27">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Counter" name="Generate Counter Offer" camunda:candidateGroups="underwriters">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_SendRejection" name="Send Rejection Reason" camunda:candidateGroups="underwriters">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_AppRejected" name="Application Rejected">
      <bpmn:incoming>Flow_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="T_InitA" name="Initiate Disbursement" camunda:type="external" camunda:topic="initiate-disbursement">
      <bpmn:incoming>Flow_37</bpmn:incoming>
      <bpmn:incoming>Flow_57</bpmn:incoming>
      <bpmn:outgoing>Flow_38</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:boundaryEvent id="B_DisbError" name="Disbursement error" attachedToRef="T_InitA">
      <bpmn:outgoing>Flow_54</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_Disbursement" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="GW_DisbSuccess" name="Disbursement successful?" default="Flow_52">
      <bpmn:incoming>Flow_50</bpmn:incoming>
      <bpmn:outgoing>Flow_51</bpmn:outgoing>
      <bpmn:outgoing>Flow_52</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_CreateLoanAccount" name="Create Loan Account" camunda:candidateGroups="underwriters">
      <bpmn:incoming>Flow_51</bpmn:incoming>
      <bpmn:outgoing>Flow_53</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_LoanDisbursed" name="Loan Disbursed">
      <bpmn:incoming>Flow_53</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_RunFraud" name="Run Fraud / AML Checks" camunda:type="external" camunda:topic="run-fraud-aml-checks">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_59</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_FraudFlag" name="Fraud / Sanction Flag?" default="Flow_61">
      <bpmn:incoming>Flow_59</bpmn:incoming>
      <bpmn:outgoing>Flow_60</bpmn:outgoing>
      <bpmn:outgoing>Flow_61</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Investigate" name="Investigate Case" camunda:type="external" camunda:topic="investigate-case">
      <bpmn:incoming>Flow_60</bpmn:incoming>
      <bpmn:outgoing>Flow_62</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_FraudConfirmed" name="Fraud Confirmed?" default="Flow_64">
      <bpmn:incoming>Flow_62</bpmn:incoming>
      <bpmn:outgoing>Flow_63</bpmn:outgoing>
      <bpmn:outgoing>Flow_64</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_RejectFile" name="Reject Application &amp; File Report" camunda:type="external" camunda:topic="reject-and-file-report">
      <bpmn:incoming>Flow_63</bpmn:incoming>
      <bpmn:outgoing>Flow_65</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Terminate" name="Terminate process Rejected (Fraud)">
      <bpmn:incoming>Flow_65</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge_Fraud">
      <bpmn:incoming>Flow_61</bpmn:incoming>
      <bpmn:incoming>Flow_64</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Handle" name="Handle Disbursement Failure (Retry / Manual)" camunda:type="external" camunda:topic="handle-disbursement-failure">
      <bpmn:incoming>Flow_52</bpmn:incoming>
      <bpmn:incoming>Flow_54</bpmn:incoming>
      <bpmn:outgoing>Flow_55</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="B_Retry" name="Retry (3 times)" attachedToRef="T_Handle" cancelActivity="false">
      <bpmn:timerEventDefinition><bpmn:timeDuration>PT5M</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="T_RequestCredit" name="Request Credit Report" camunda:candidateGroups="loan-officers">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_70</bpmn:incoming>
      <bpmn:outgoing>Flow_66</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_Api" name="System error / API timeout" attachedToRef="T_RequestCredit">
      <bpmn:outgoing>Flow_67</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_ApiTimeout" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="T_RetryC" name="Retry (3 times)" camunda:type="external" camunda:topic="retry-credit-request">
      <bpmn:incoming>Flow_67</bpmn:incoming>
      <bpmn:outgoing>Flow_68</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_StillC" name="Still fails?" default="Flow_70">
      <bpmn:incoming>Flow_68</bpmn:incoming>
      <bpmn:outgoing>Flow_69</bpmn:outgoing>
      <bpmn:outgoing>Flow_70</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_ManualCredit" name="Manual Credit Check (by Loan Officer)" camunda:candidateGroups="loan-officers">
      <bpmn:incoming>Flow_69</bpmn:incoming>
      <bpmn:outgoing>Flow_71</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="T_ReceiveCredit" name="Receive Credit Report" messageRef="Message_CreditReport">
      <bpmn:incoming>Flow_66</bpmn:incoming>
      <bpmn:incoming>Flow_71</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="GW_Outcome" default="Flow_56">
      <bpmn:incoming>Flow_55</bpmn:incoming>
      <bpmn:outgoing>Flow_56</bpmn:outgoing>
      <bpmn:outgoing>Flow_57</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Hold" name="Hold Funds &amp; Contact Applicant" camunda:candidateGroups="operations">
      <bpmn:incoming>Flow_56</bpmn:incoming>
      <bpmn:outgoing>Flow_58</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_AppFailed" name="Application Failed">
      <bpmn:incoming>Flow_58</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_VerifyCollateral" name="Verify Collateral (if secured loan)" camunda:type="external" camunda:topic="verify-collateral">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_72</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Collateral" name="Collateral" default="Flow_74">
      <bpmn:incoming>Flow_72</bpmn:incoming>
      <bpmn:outgoing>Flow_73</bpmn:outgoing>
      <bpmn:outgoing>Flow_74</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Revaluation" name="Revaluation / Reduce LTV" camunda:type="external" camunda:topic="revaluation-reduce-ltv">
