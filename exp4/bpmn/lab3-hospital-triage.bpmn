<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Claude" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.7.0">
  <process id="Process_HospitalTriage" name="Hospital Appointment and Triage" isExecutable="true">
    <startEvent id="Start" name="Appointment request received">
      <documentation>Synthetic data only. Input variables: patientRef, appointmentPreference, symptomsSummary, urgencyIndicators (list), ageGroup</documentation>
      <outgoing>Flow_01</outgoing>
    </startEvent>
    <serviceTask id="Validate" name="Validate registration">
      <extensionElements>
        <zeebe:taskDefinition type="validate-registration" retries="3" />
      </extensionElements>
      <incoming>Flow_01</incoming>
      <outgoing>Flow_02</outgoing>
    </serviceTask>
    <exclusiveGateway id="GwReg" name="Registration valid?" default="Flow_04">
      <incoming>Flow_02</incoming>
      <outgoing>Flow_03</outgoing>
      <outgoing>Flow_04</outgoing>
    </exclusiveGateway>
    <endEvent id="EndInvalid" name="Rejected: invalid registration">
      <incoming>Flow_04</incoming>
    </endEvent>
    <businessRuleTask id="Dmn" name="Classify triage">
      <extensionElements>
        <zeebe:calledDecision decisionId="triageCategory" resultVariable="triageCategory" />
      </extensionElements>
      <incoming>Flow_03</incoming>
      <outgoing>Flow_05</outgoing>
    </businessRuleTask>
    <exclusiveGateway id="GwTriage" name="Triage category?" default="Flow_08">
      <incoming>Flow_05</incoming>
      <outgoing>Flow_06</outgoing>
      <outgoing>Flow_07</outgoing>
      <outgoing>Flow_08</outgoing>
    </exclusiveGateway>
    <userTask id="Urgent" name="Immediate human assessment">
      <extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="clinical-staff" />
      <zeebe:formDefinition formId="urgent-assessment-form" bindingType="deployment" /></extensionElements>
      <incoming>Flow_06</incoming>
      <outgoing>Flow_09</outgoing>
    </userTask>
    <endEvent id="EndUrgent" name="Urgent case handed to staff">
      <incoming>Flow_09</incoming>
    </endEvent>
    <userTask id="Priority" name="Priority staff review">
      <extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="clinical-staff" />
      <zeebe:formDefinition formId="priority-review-form" bindingType="deployment" /></extensionElements>
      <incoming>Flow_07</incoming>
      <outgoing>Flow_10</outgoing>
    </userTask>
    <exclusiveGateway id="Merge">
      <incoming>Flow_08</incoming>
      <incoming>Flow_10</incoming>
      <outgoing>Flow_11</outgoing>
    </exclusiveGateway>
    <serviceTask id="Slots" name="Retrieve available slots (REST)" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="GET" target="method" /><zeebe:input source="=&quot;http://localhost:8081/mock/slots?preference=&quot; + appointmentPreference" target="url" /><zeebe:input source="10" target="connectionTimeoutInSeconds" /><zeebe:input source="10" target="readTimeoutInSeconds" /></zeebe:ioMapping>
        <zeebe:taskHeaders><zeebe:header key="resultVariable" value="slotsResponse" /><zeebe:header key="resultExpression" value="={availableSlots: response.body.slots}" /><zeebe:header key="retryBackoff" value="PT0S" /></zeebe:taskHeaders>
      </extensionElements>
      <incoming>Flow_11</incoming>
      <outgoing>Flow_12</outgoing>
    </serviceTask>
    <exclusiveGateway id="GwSlots" name="Slots available?" default="Flow_14">
      <incoming>Flow_12</incoming>
      <outgoing>Flow_13</outgoing>
      <outgoing>Flow_14</outgoing>
    </exclusiveGateway>
    <serviceTask id="Book" name="Book appointment">
      <extensionElements>
        <zeebe:taskDefinition type="book-appointment" retries="3" />
      </extensionElements>
      <incoming>Flow_13</incoming>
      <outgoing>Flow_15</outgoing>
    </serviceTask>
    <endEvent id="EndBooked" name="Appointment booked">
      <incoming>Flow_15</incoming>
    </endEvent>
    <userTask id="NoSlot" name="Staff review: no slot">
      <extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="scheduling-staff" />
      <zeebe:formDefinition formId="no-slot-review-form" bindingType="deployment" /></extensionElements>
      <incoming>Flow_14</incoming>
      <outgoing>Flow_16</outgoing>
    </userTask>
    <endEvent id="EndNoSlot" name="Referred to staff">
      <incoming>Flow_16</incoming>
    </endEvent>
    <sequenceFlow id="Flow_01" sourceRef="Start" targetRef="Validate" />
    <sequenceFlow id="Flow_02" sourceRef="Validate" targetRef="GwReg" />
    <sequenceFlow id="Flow_03" sourceRef="GwReg" targetRef="Dmn" name="valid">
      <conditionExpression xsi:type="bpmn:tFormalExpression">=isRegistrationValid = true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_04" sourceRef="GwReg" targetRef="EndInvalid" name="invalid" />
    <sequenceFlow id="Flow_05" sourceRef="Dmn" targetRef="GwTriage" />
    <sequenceFlow id="Flow_06" sourceRef="GwTriage" targetRef="Urgent" name="Urgent">
      <conditionExpression xsi:type="bpmn:tFormalExpression">=triageCategory = "Urgent Assessment"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_07" sourceRef="GwTriage" targetRef="Priority" name="Priority">
      <conditionExpression xsi:type="bpmn:tFormalExpression">=triageCategory = "Priority Review"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_08" sourceRef="GwTriage" targetRef="Merge" name="Routine" />
    <sequenceFlow id="Flow_09" sourceRef="Urgent" targetRef="EndUrgent" />
    <sequenceFlow id="Flow_10" sourceRef="Priority" targetRef="Merge" />
    <sequenceFlow id="Flow_11" sourceRef="Merge" targetRef="Slots" />
    <sequenceFlow id="Flow_12" sourceRef="Slots" targetRef="GwSlots" />
    <sequenceFlow id="Flow_13" sourceRef="GwSlots" targetRef="Book" name="slots found">
      <conditionExpression xsi:type="bpmn:tFormalExpression">=count(slotsResponse.availableSlots) &gt; 0</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_14" sourceRef="GwSlots" targetRef="NoSlot" name="none" />
    <sequenceFlow id="Flow_15" sourceRef="Book" targetRef="EndBooked" />
    <sequenceFlow id="Flow_16" sourceRef="NoSlot" targetRef="EndNoSlot" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_HospitalTriage">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="102" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="75" y="402" width="90" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Validate_di" bpmnElement="Validate">
        <dc:Bounds x="230" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwReg_di" bpmnElement="GwReg" isMarkerVisible="true">
        <dc:Bounds x="415" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="345" y="325" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndInvalid_di" bpmnElement="EndInvalid">
        <dc:Bounds x="582" y="502" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="555" y="542" width="90" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Dmn_di" bpmnElement="Dmn">
        <dc:Bounds x="550" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwTriage_di" bpmnElement="GwTriage" isMarkerVisible="true">
        <dc:Bounds x="735" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="665" y="325" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Urgent_di" bpmnElement="Urgent">
        <dc:Bounds x="870" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndUrgent_di" bpmnElement="EndUrgent">
        <dc:Bounds x="1062" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1035" y="122" width="90" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Priority_di" bpmnElement="Priority">
        <dc:Bounds x="870" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Merge_di" bpmnElement="Merge" isMarkerVisible="true">
        <dc:Bounds x="1055" y="355" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Slots_di" bpmnElement="Slots">
        <dc:Bounds x="1190" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwSlots_di" bpmnElement="GwSlots" isMarkerVisible="true">
        <dc:Bounds x="1375" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1305" y="325" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Book_di" bpmnElement="Book">
        <dc:Bounds x="1510" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndBooked_di" bpmnElement="EndBooked">
        <dc:Bounds x="1702" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1675" y="402" width="90" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NoSlot_di" bpmnElement="NoSlot">
        <dc:Bounds x="1510" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndNoSlot_di" bpmnElement="EndNoSlot">
        <dc:Bounds x="1702" y="502" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1675" y="542" width="90" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="138" y="380" />
        <di:waypoint x="230" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="330" y="380" />
        <di:waypoint x="415" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="465" y="380" />
        <di:waypoint x="550" y="380" />
        <bpmndi:BPMNLabel><dc:Bounds x="471" y="360" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04">
        <di:waypoint x="440" y="405" />
        <di:waypoint x="440" y="520" />
        <di:waypoint x="582" y="520" />
        <bpmndi:BPMNLabel><dc:Bounds x="446" y="411" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05">
        <di:waypoint x="650" y="380" />
        <di:waypoint x="735" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06">
        <di:waypoint x="760" y="355" />
        <di:waypoint x="760" y="100" />
        <di:waypoint x="870" y="100" />
        <bpmndi:BPMNLabel><dc:Bounds x="766" y="333" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07">
        <di:waypoint x="760" y="405" />
        <di:waypoint x="760" y="520" />
        <di:waypoint x="870" y="520" />
        <bpmndi:BPMNLabel><dc:Bounds x="766" y="411" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08">
        <di:waypoint x="785" y="380" />
        <di:waypoint x="1055" y="380" />
        <bpmndi:BPMNLabel><dc:Bounds x="791" y="360" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09">
        <di:waypoint x="970" y="100" />
        <di:waypoint x="1062" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="970" y="520" />
        <di:waypoint x="1080" y="520" />
        <di:waypoint x="1080" y="405" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1105" y="380" />
        <di:waypoint x="1190" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="1290" y="380" />
        <di:waypoint x="1375" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="1425" y="380" />
        <di:waypoint x="1510" y="380" />
        <bpmndi:BPMNLabel><dc:Bounds x="1431" y="360" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14">
        <di:waypoint x="1400" y="405" />
        <di:waypoint x="1400" y="520" />
        <di:waypoint x="1510" y="520" />
        <bpmndi:BPMNLabel><dc:Bounds x="1406" y="411" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15">
        <di:waypoint x="1610" y="380" />
        <di:waypoint x="1702" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16">
        <di:waypoint x="1610" y="520" />
        <di:waypoint x="1702" y="520" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>