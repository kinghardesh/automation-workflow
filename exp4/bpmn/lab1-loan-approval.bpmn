<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Claude" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.7.0">
  <error id="Error_Credit" name="Credit API error" zeebe:errorCode="CREDIT_API_ERROR" />
  <process id="Process_LoanApproval" name="Loan Approval" isExecutable="true">
    <startEvent id="Start" name="Loan application received">
      <documentation>Input variables: applicantId, applicantName, requestedAmount, monthlyIncome, employmentStatus, loanPurpose</documentation>
      <outgoing>Flow_01</outgoing>
    </startEvent>
    <serviceTask id="Validate" name="Validate applicant">
      <extensionElements>
        <zeebe:taskDefinition type="validate-applicant" retries="3" />
      </extensionElements>
      <incoming>Flow_01</incoming>
      <outgoing>Flow_02</outgoing>
    </serviceTask>
    <exclusiveGateway id="GwValid" name="Valid?" default="Flow_04">
      <incoming>Flow_02</incoming>
      <outgoing>Flow_03</outgoing>
      <outgoing>Flow_04</outgoing>
    </exclusiveGateway>
    <endEvent id="EndInvalid" name="Rejected: invalid application">
      <incoming>Flow_04</incoming>
    </endEvent>
    <serviceTask id="Credit" name="Credit assessment (REST)" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source="http://localhost:8081/mock/credit-assessment" target="url" /><zeebe:input source="={&quot;applicantId&quot;: applicantId, &quot;monthlyIncome&quot;: monthlyIncome, &quot;requestedAmount&quot;: requestedAmount}" target="body" /><zeebe:input source="10" target="connectionTimeoutInSeconds" /><zeebe:input source="10" target="readTimeoutInSeconds" /></zeebe:ioMapping>
        <zeebe:taskHeaders><zeebe:header key="resultVariable" value="creditResponse" /><zeebe:header key="resultExpression" value="={creditScore: response.body.creditScore, creditRating: response.body.rating}" /><zeebe:header key="retryBackoff" value="PT0S" /></zeebe:taskHeaders>
      </extensionElements>
      <incoming>Flow_03</incoming>
      <outgoing>Flow_05</outgoing>
    </serviceTask>
    <businessRuleTask id="Dmn" name="Evaluate loan decision">
      <extensionElements>
        <zeebe:calledDecision decisionId="loanDecision" resultVariable="loanDecision" />
      </extensionElements>
      <incoming>Flow_05</incoming>
      <outgoing>Flow_08</outgoing>
    </businessRuleTask>
    <exclusiveGateway id="GwDecision" name="Decision?" default="Flow_11">
      <incoming>Flow_08</incoming>
      <outgoing>Flow_09</outgoing>
      <outgoing>Flow_10</outgoing>
      <outgoing>Flow_11</outgoing>
    </exclusiveGateway>
    <endEvent id="EndApproved" name="Loan approved">
      <incoming>Flow_09</incoming>
    </endEvent>
    <endEvent id="EndRejected" name="Loan rejected">
      <incoming>Flow_10</incoming>
    </endEvent>
    <userTask id="Review" name="Manual review">
      <extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="loan-officers" />
      <zeebe:formDefinition formId="loan-review-form" bindingType="deployment" /></extensionElements>
      <incoming>Flow_11</incoming>
      <outgoing>Flow_12</outgoing>
    </userTask>
    <exclusiveGateway id="GwReview" name="Reviewer approved?" default="Flow_14">
      <incoming>Flow_12</incoming>
      <outgoing>Flow_13</outgoing>
      <outgoing>Flow_14</outgoing>
    </exclusiveGateway>
    <endEvent id="EndApproved2" name="Approved after review">
      <incoming>Flow_13</incoming>
    </endEvent>
    <endEvent id="EndRejected2" name="Rejected after review">
      <incoming>Flow_14</incoming>
    </endEvent>
    <sequenceFlow id="Flow_01" sourceRef="Start" targetRef="Validate" />
    <sequenceFlow id="Flow_02" sourceRef="Validate" targetRef="GwValid" />
    <sequenceFlow id="Flow_03" sourceRef="GwValid" targetRef="Credit" name="valid">
      <conditionExpression xsi:type="bpmn:tFormalExpression">=isValid = true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_04" sourceRef="GwValid" targetRef="EndInvalid" name="invalid" />
    <sequenceFlow id="Flow_05" sourceRef="Credit" targetRef="Dmn" />
    <sequenceFlow id="Flow_08" sourceRef="Dmn" targetRef="GwDecision" />
    <sequenceFlow id="Flow_09" sourceRef="GwDecision" targetRef="EndApproved" name="Approved">
      <conditionExpression xsi:type="bpmn:tFormalExpression">=loanDecision = "Approved"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_10" sourceRef="GwDecision" targetRef="EndRejected" name="Rejected">
      <conditionExpression xsi:type="bpmn:tFormalExpression">=loanDecision = "Rejected"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_11" sourceRef="GwDecision" targetRef="Review" name="Manual Review" />
    <sequenceFlow id="Flow_12" sourceRef="Review" targetRef="GwReview" />
    <sequenceFlow id="Flow_13" sourceRef="GwReview" targetRef="EndApproved2" name="yes">
      <conditionExpression xsi:type="bpmn:tFormalExpression">=reviewApproved = true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_14" sourceRef="GwReview" targetRef="EndRejected2" name="no" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_LoanApproval">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="102" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="75" y="262" width="90" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Validate_di" bpmnElement="Validate">
        <dc:Bounds x="230" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwValid_di" bpmnElement="GwValid" isMarkerVisible="true">
        <dc:Bounds x="415" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="345" y="185" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndInvalid_di" bpmnElement="EndInvalid">
        <dc:Bounds x="582" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="555" y="122" width="90" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Credit_di" bpmnElement="Credit">
        <dc:Bounds x="550" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CreditErr_di" bpmnElement="CreditErr">
        <dc:Bounds x="582" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="622" y="284" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FailTask_di" bpmnElement="FailTask">
        <dc:Bounds x="550" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndHeld_di" bpmnElement="EndHeld">
        <dc:Bounds x="742" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="715" y="402" width="90" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Dmn_di" bpmnElement="Dmn">
        <dc:Bounds x="710" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwDecision_di" bpmnElement="GwDecision" isMarkerVisible="true">
        <dc:Bounds x="895" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="825" y="185" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndApproved_di" bpmnElement="EndApproved">
        <dc:Bounds x="1062" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1035" y="122" width="90" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndRejected_di" bpmnElement="EndRejected">
        <dc:Bounds x="1062" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1035" y="402" width="90" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Review_di" bpmnElement="Review">
        <dc:Bounds x="1030" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwReview_di" bpmnElement="GwReview" isMarkerVisible="true">
        <dc:Bounds x="1215" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1145" y="185" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndApproved2_di" bpmnElement="EndApproved2">
        <dc:Bounds x="1382" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1355" y="122" width="90" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndRejected2_di" bpmnElement="EndRejected2">
        <dc:Bounds x="1382" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1355" y="402" width="90" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="138" y="240" />
        <di:waypoint x="230" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="330" y="240" />
        <di:waypoint x="415" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="465" y="240" />
        <di:waypoint x="550" y="240" />
        <bpmndi:BPMNLabel><dc:Bounds x="471" y="220" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04">
        <di:waypoint x="440" y="215" />
        <di:waypoint x="440" y="100" />
        <di:waypoint x="582" y="100" />
        <bpmndi:BPMNLabel><dc:Bounds x="446" y="193" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05">
        <di:waypoint x="650" y="240" />
        <di:waypoint x="710" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06">
        <di:waypoint x="600" y="298" />
        <di:waypoint x="600" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07">
        <di:waypoint x="650" y="380" />
        <di:waypoint x="742" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08">
        <di:waypoint x="810" y="240" />
        <di:waypoint x="895" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09">
        <di:waypoint x="920" y="215" />
        <di:waypoint x="920" y="100" />
        <di:waypoint x="1062" y="100" />
        <bpmndi:BPMNLabel><dc:Bounds x="926" y="193" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="920" y="265" />
        <di:waypoint x="920" y="380" />
        <di:waypoint x="1062" y="380" />
        <bpmndi:BPMNLabel><dc:Bounds x="926" y="271" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="945" y="240" />
        <di:waypoint x="1030" y="240" />
        <bpmndi:BPMNLabel><dc:Bounds x="951" y="220" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="1130" y="240" />
        <di:waypoint x="1215" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="1240" y="215" />
        <di:waypoint x="1240" y="100" />
        <di:waypoint x="1382" y="100" />
        <bpmndi:BPMNLabel><dc:Bounds x="1246" y="193" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14">
        <di:waypoint x="1240" y="265" />
        <di:waypoint x="1240" y="380" />
        <di:waypoint x="1382" y="380" />
        <bpmndi:BPMNLabel><dc:Bounds x="1246" y="271" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>